# ============================================================
# Click Fixed — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Google Gemini API Key (required for cloud AI fallback)
# Get it from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Web Risk API Key (optional — requires enterprise Cloud access)
# Get it from: https://console.cloud.google.com/apis/library/webrisk.googleapis.com
# Leave blank to use the public Safe Browsing report link as a fallback.
WEBRISK_API_KEY=

# Google Cloud Project ID (used with Web Risk API)
GOOGLE_CLOUD_PROJECT=your_project_id_here
