# ─── Secrets — NEVER commit ──────────────────────────────────
.env
*.env
*.key
*.pem
*.p12
secrets/

# ─── Terraform ───────────────────────────────────────────────
# Real variable values — use terraform.tfvars.example instead
infra/terraform.tfvars
infra/terraform.tfstate
infra/terraform.tfstate.backup
infra/.terraform/
infra/terraform.exe
infra/*.tfplan

# ─── GCP credentials ─────────────────────────────────────────
*.json.key
service-account*.json
gcloud-key*.json
application_default_credentials.json

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
venv/
.venv/
env/
.Python

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Extension build artifacts ───────────────────────────────
extension/dist/
*.zip

